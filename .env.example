# ==============================================================================
# Plantilla de Variables de Entorno — SeniorVital Backend API
# Copiar este archivo como .env y rellenar los valores según el entorno
# ==============================================================================

# Base de Datos (Supabase PostgreSQL / Cloud Pooler en puerto 6543)
DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Inferencia de Inteligencia Artificial (Google AI Studio - Recomendado)
GEMINI_API_KEY=your_google_ai_studio_key_here

# Inferencia de Inteligencia Artificial de Respaldo (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
DEFAULT_LLM_MODEL=google/gemma-4-31b:free

# Modelo de Embeddings Vectoriales Serverless (Hugging Face API / pgvector)
HF_TOKEN=hf_your_hugging_face_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Servidor Local Ollama (Opcional)
OLLAMA_URL=http://localhost:11434

# Seguridad y Autenticación JWT (Generar con: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Web Push Notifications (Claves VAPID NIST P-256)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIM_EMAIL=mailto:soporte@seniorvital.com

# Servidor y Entorno
PORT=8000
ENVIRONMENT=production
