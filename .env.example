# Copia este archivo como .env y coloca tus valores reales

# Conexión a la base de datos (Supabase, Neon, RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Claves de OpenRouter (para LangChain y LLM)
OPENROUTER_API_KEY=tu_api_key_aqui
DEFAULT_LLM_MODEL=inclusionai/ling-3.0-flash:free

# Puerto de la aplicación (Render asigna esto dinámicamente)
PORT=8000
