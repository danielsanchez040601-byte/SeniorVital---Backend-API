# ==============================================================================
# Plantilla de Variables de Entorno — SeniorVital Backend API
# Copiar este archivo como .env y rellenar los valores según el entorno
# ==============================================================================

# Base de Datos (Supabase PostgreSQL / Cloud SQL)
DATABASE_URL=postgresql+asyncpg://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres

# Inferencia de Inteligencia Artificial (Google AI Studio - Recomendado)
GEMINI_API_KEY=tu_clave_de_google_ai_studio_aqui

# Inferencia de Inteligencia Artificial de Respaldo (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-tu_clave_de_openrouter_aqui
DEFAULT_LLM_MODEL=google/gemma-4-31b-it:free

# Modelo de Embeddings Vectoriales (pgvector)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Seguridad y Autenticación JWT
JWT_SECRET=generar_clave_segura_para_produccion_con_openssl_rand_hex_32

# Servidor y Entorno
PORT=8000
ENVIRONMENT=production
